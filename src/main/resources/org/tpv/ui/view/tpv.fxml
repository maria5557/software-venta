<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="722.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tpv.ui.controller.VentaController">
    <top>
        <VBox spacing="10" style="-fx-padding: 10;">
            <children>
                <!-- Fila 1: Código de barras y botones principales -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Código de barras:" />
                        <TextField fx:id="txtCodigoBarra" onAction="#onAñadirProducto" prefWidth="250" promptText="Escanea o escribe el código..." />
                        <Button fx:id="btnAñadir" onAction="#onAñadirProducto" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold;" text="Añadir" />

                        <Region HBox.hgrow="ALWAYS" />

                        <Button fx:id="btnNuevaVenta" onAction="#onNuevaVenta" text="Nueva Venta" />
                        <Button fx:id="btnCobrar" onAction="#onCobrar" style="-fx-background-color: green; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 10 30;" text="COBRAR" />
                    </children>
                </HBox>

                <!-- Fila 2: Modificar cantidad -->
                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 5 0 0 0;">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Modificar línea seleccionada:" />
                        <Button fx:id="btnIncrementar" onAction="#onIncrementar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;" text="+1" />
                        <Button fx:id="btnDecrementar" onAction="#onDecrementar" style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-weight: bold;" text="-1" />
                        <Button fx:id="btnEliminar" onAction="#onEliminarLinea" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-weight: bold;" text="🗑 Eliminar" />

                        <Label style="-fx-text-fill: #2196F3; -fx-font-style: italic; -fx-font-size: 12px;" text="💡 Haz click en cualquier celda para editarla • Los precios incluyen IVA del 21%" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <right>
        <VBox prefHeight="200.0" prefWidth="180.0" spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-font-weight: bold; -fx-font-size: 18; -fx-underline: true;" text="RESUMEN" />

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold;" text="Total sin IVA:" />
                    <Label fx:id="lblTotalSinIva" style="-fx-font-size: 16;" text="0.00€" />
                </VBox>

                <VBox spacing="5">
                    <Label style="-fx-font-weight: bold;" text="IVA (21%):" />
                    <Label fx:id="lblIva" style="-fx-font-size: 16;" text="0.00€" />
                </VBox>

                <VBox spacing="5" style="-fx-border-color: green; -fx-border-width: 2 0 0 0; -fx-padding: 10 0 0 0;">
                    <Label style="-fx-font-weight: bold; -fx-font-size: 18;" text="TOTAL:" />
                    <Label fx:id="lblTotal" style="-fx-font-size: 24; -fx-text-fill: green; -fx-font-weight: bold;" text="0.00€" />
                </VBox>
            </children>
        </VBox>
    </right>

    <center>
        <TableView fx:id="tablaTicket" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCodigo" editable="true" prefWidth="100.0" text="CÓDIGO" />
                <TableColumn fx:id="colNombre" editable="true" prefWidth="220.0" text="PRODUCTO" />
                <TableColumn fx:id="colCantidad" editable="true" prefWidth="90.0" text="CANT." />
                <TableColumn fx:id="colPrecio" editable="true" prefWidth="120.0" text="PRECIO (IVA incl.)" />
                <TableColumn fx:id="colDescuento" editable="true" prefWidth="100.0" text="DESC (%)" />
                <TableColumn fx:id="colSubtotal" editable="false" prefWidth="130.0" text="SUBTOTAL" />
            </columns>
        </TableView>
    </center>
</BorderPane>
