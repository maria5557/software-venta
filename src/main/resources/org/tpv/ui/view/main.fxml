<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.tpv.ui.controller.MainController"
            prefHeight="800.0" prefWidth="1400.0">

    <!-- BARRA SUPERIOR -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="🛒 TPV - Sistema de Ventas" textFill="white"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;" />

                <Region HBox.hgrow="ALWAYS" />

                <Label fx:id="lblUsuario" text="Usuario: Admin" textFill="white"
                       style="-fx-font-size: 14px;" />
                <Label fx:id="lblFechaHora" text="" textFill="white"
                       style="-fx-font-size: 14px;" />
            </HBox>
        </VBox>
    </top>

    <!-- MENÚ LATERAL IZQUIERDO -->
    <left>
        <VBox spacing="0" prefWidth="220"
              style="-fx-background-color: #34495e; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0, 2, 0);">

            <!-- LOGO / TÍTULO -->
            <VBox alignment="CENTER" style="-fx-padding: 30 20; -fx-background-color: #2c3e50;">
                <Label text="TPV" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" />
                <Label text="Terminal Punto Venta" style="-fx-font-size: 11px; -fx-text-fill: #95a5a6;" />
            </VBox>

            <Separator style="-fx-background-color: #2c3e50;" />

            <!-- OPCIONES DEL MENÚ -->
            <VBox spacing="3" style="-fx-padding: 10;">

                <Button fx:id="btnMenuVentas" onAction="#mostrarVentas"
                        text="🎫 Nueva Venta" maxWidth="Infinity"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 15; -fx-background-radius: 5; -fx-cursor: hand; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets bottom="10" />
                    </VBox.margin>
                </Button>

                <Label text="GESTIÓN" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 5 5 5;" />

                <Button fx:id="btnMenuProductos" onAction="#mostrarProductos"
                        text="📦 Productos" maxWidth="Infinity"
                        styleClass="menu-button"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 12 15; -fx-background-radius: 5; -fx-cursor: hand; -fx-alignment: CENTER-LEFT;" />

                <Button fx:id="btnMenuFacturas" onAction="#mostrarFacturas"
                        text="📄 Facturas" maxWidth="Infinity"
                        styleClass="menu-button"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 12 15; -fx-background-radius: 5; -fx-cursor: hand; -fx-alignment: CENTER-LEFT;" />

                <Button fx:id="btnMenuClientes" onAction="#mostrarClientes"
                        text="👥 Clientes" maxWidth="Infinity"
                        styleClass="menu-button"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 12 15; -fx-background-radius: 5; -fx-cursor: hand; -fx-alignment: CENTER-LEFT;" />

                <Separator style="-fx-background-color: #2c3e50;">
                    <VBox.margin>
                        <Insets top="10" bottom="10" />
                    </VBox.margin>
                </Separator>

                <Label text="CONFIGURACIÓN" style="-fx-text-fill: #95a5a6; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 5 5 5 5;" />

                <Button fx:id="btnMenuConfiguracion" onAction="#mostrarConfiguracion"
                        text="Configuración" maxWidth="Infinity"
                        styleClass="menu-button"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 12 15; -fx-background-radius: 5; -fx-cursor: hand; -fx-alignment: CENTER-LEFT;" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- PIE DEL MENÚ -->
            <VBox alignment="CENTER" style="-fx-padding: 20; -fx-background-color: #2c3e50;">
                <Label text="Versión 1.0.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 10px;" />
            </VBox>
        </VBox>
    </left>

    <!-- ÁREA DE CONTENIDO CENTRAL -->
    <center>
        <StackPane fx:id="contenidoCentral" style="-fx-background-color: #f5f5f5;" />
    </center>
</BorderPane>