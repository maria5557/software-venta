<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tpv.ui.controller.ConfiguracionController">

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="⚙️ Configuración del Sistema" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
    </HBox>

    <!-- FORMULARIO DE CONFIGURACIÓN -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

        <Label text="DATOS DE LA TIENDA" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />

        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="150" />
                <ColumnConstraints minWidth="300" hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="Nombre de la tienda:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtNombreTienda" GridPane.columnIndex="1" GridPane.rowIndex="0"
                       promptText="Nombre del negocio" />

            <Label text="Dirección:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtDireccion" GridPane.columnIndex="1" GridPane.rowIndex="1"
                       promptText="Calle y número" />

            <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtCiudad" GridPane.columnIndex="1" GridPane.rowIndex="2"
                       promptText="Ciudad" />

            <Label text="Código Postal:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtCodigoPostal" GridPane.columnIndex="1" GridPane.rowIndex="3"
                       promptText="CP" />

            <Label text="Teléfono:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="4"
                       promptText="Teléfono de contacto" />

            <Label text="CIF:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtCif" GridPane.columnIndex="1" GridPane.rowIndex="5"
                       promptText="CIF de la empresa" />

            <Label text="NIF:" GridPane.columnIndex="0" GridPane.rowIndex="6"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtNif" GridPane.columnIndex="1" GridPane.rowIndex="6"
                       promptText="NIF del titular" />

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="7"
                   style="-fx-font-weight: bold;" />
            <TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="7"
                       promptText="Email de contacto" />
        </GridPane>

        <Separator />

        <Label text="PARÁMETROS FISCALES" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />

        <GridPane hgap="20" vgap="15">
            <columnConstraints>
                <ColumnConstraints minWidth="150" />
                <ColumnConstraints minWidth="300" hgrow="ALWAYS" />
            </columnConstraints>

            <Label text="IVA General (%):" GridPane.columnIndex="0" GridPane.rowIndex="0"
                   style="-fx-font-weight: bold;" />
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Spinner fx:id="spinnerIva" min="0" max="100" initialValue="21"
                         editable="true" prefWidth="100" />

            </HBox>
        </GridPane>

        <Separator />

        <!-- BOTONES -->
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button fx:id="btnGuardar" text="💾 Guardar Cambios" onAction="#guardarConfiguracion"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand;" />
            <Button fx:id="btnCancelar" text="✖ Cancelar" onAction="#cancelar"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 12 30; -fx-background-radius: 5; -fx-cursor: hand;" />
        </HBox>
    </VBox>
</VBox>