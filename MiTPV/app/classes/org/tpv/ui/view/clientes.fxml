<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" style="-fx-padding: 20; -fx-background-color: #f5f5f5;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.tpv.ui.controller.ClientesController">

    <!-- CABECERA -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
        <Label text="👥 Gestión de Clientes" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />

        <Region HBox.hgrow="ALWAYS" />

        <TextField fx:id="txtBusquedaCliente" promptText="Buscar por nombre o DNI..." prefWidth="250"
                   style="-fx-font-size: 14px; -fx-padding: 8;" />
        <Button fx:id="btnBuscarCliente" text="🔍 Buscar" onAction="#buscarCliente"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;" />
        <Button fx:id="btnNuevoCliente" text="➕ Nuevo Cliente" onAction="#crearNuevoCliente"
                style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-padding: 8 20; -fx-background-radius: 5; -fx-cursor: hand;" />
    </HBox>

    <!-- TABLA DE CLIENTES -->
    <VBox VBox.vgrow="ALWAYS"
          style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">

        <HBox alignment="CENTER_LEFT" style="-fx-padding: 15; -fx-background-color: #ecf0f1; -fx-background-radius: 8 8 0 0;">
            <Label text="LISTA DE CLIENTES" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTotalClientes" text="0 clientes" style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />
        </HBox>

        <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: white;">
            <columns>
                <TableColumn fx:id="colDni" prefWidth="150.0" text="DNI/NIF" />
                <TableColumn fx:id="colNombre" prefWidth="300.0" text="NOMBRE" />
                <TableColumn fx:id="colTelefono" prefWidth="150.0" text="TELÉFONO" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="EMAIL" />
                <TableColumn fx:id="colAcciones" prefWidth="150.0" text="ACCIONES" />
            </columns>
            <placeholder>
                <Label text="No hay clientes registrados" style="-fx-font-size: 14px; -fx-text-fill: #95a5a6;" />
            </placeholder>
        </TableView>
    </VBox>
</VBox>